# Copy to .env. Do not commit .env or put keys in chat/browser.
DEMO_MODE=true
PULSE_PORT=8000
# Required before a public deployment. Common password for the contest stand,
# not a replacement for bank IAM or individual customer access control.
APP_ACCESS_TOKEN=

# OpenAI-compatible gateway supplied by the organizers; HTTPS only.
LLM_BASE_URL=
LLM_API_KEY=
# Exact API identifier from the organizers, not an invented model alias.
LLM_MODEL_ID=
# One exact family name from Appendix 3, e.g. Qwen3.6 35B A3B
LLM_MODEL_FAMILY=
# Actual gateway prices in RUB per million tokens; both must be > 0.
LLM_INPUT_RUB_PER_MILLION=0
LLM_OUTPUT_RUB_PER_MILLION=0
DAILY_BUDGET_RUB=500
# Conservative UTF-8 payload byte ceiling; confirm gateway context capacity.
LLM_CONTEXT_LIMIT=48000
LLM_MAX_OUTPUT=1600
NEWS_POLL_MINUTES=30

# Confirm source CSV revenue unit before filtering real companies by 15B RUB.
REVENUE_MULTIPLIER=1
REVENUE_UNIT_CONFIRMED=false
# Optional path when OCR language data isn't installed system-wide.
TESSDATA_PREFIX=
